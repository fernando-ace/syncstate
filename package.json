{
  "name": "electron-global-state-sync",
  "version": "0.1.0",
  "description": "Type-safe global state synchronized across Electron main and renderer processes, with React hooks.",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "files": [
    "dist/*.cjs",
    "dist/*.mjs",
    "dist/*.d.cts",
    "dist/*.d.ts"
  ],
  "license": "MIT",
  "author": "Fernando Acevedo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernando-ace/electron-global-state-sync.git"
  },
  "bugs": {
    "url": "https://github.com/fernando-ace/electron-global-state-sync/issues"
  },
  "homepage": "https://github.com/fernando-ace/electron-global-state-sync#readme",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "state-management",
    "ipc",
    "contextbridge"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    },
    "./main": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    },
    "./preload": {
      "import": {
        "types": "./dist/preload.d.ts",
        "default": "./dist/preload.mjs"
      },
      "require": {
        "types": "./dist/preload.d.cts",
        "default": "./dist/preload.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.mjs"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.mjs"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "build:lib": "tsup",
    "build:demo": "vite build",
    "demo": "npm run build && electron .",
    "demo:smoke": "npm run build && node scripts/demo-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "electron": ">=30",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
